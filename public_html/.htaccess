<IfModule mod_rewrite.c>
    RewriteEngine On

    # ✅ Force HTTPS + NON-WWW together
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.rnvalves\.com [NC]
    RewriteRule ^(.*)$ https://rnvalves.com/$1 [L,R=301]

    # ✅ Redirect to public folder (Laravel)
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>